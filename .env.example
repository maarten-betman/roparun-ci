# Copy to .env and fill in. All keys are optional for local dev.

# Prettier OSM tiles via MapTiler free tier.
# Without this, the frontend falls back to MapLibre demotiles.
VITE_MAPTILER_KEY=

# Backend settings (override defaults from docker-compose if needed).
# ROPARUN_DATABASE_URL=postgresql+psycopg://roparun:roparun@db:5432/roparun
# ROPARUN_CORS_ORIGINS=["http://localhost:5173"]
