# Copy to `.env` on your Coolify deploy (or set these as service env vars).
#
# Postgres superuser password for the internal db. Use something strong —
# the db isn't exposed to the host in compose.prod.yml, but rotating is easier
# than recovering from a leak.
POSTGRES_PASSWORD=change-me

# Origins allowed by FastAPI CORS. JSON list. Use your public frontend URL.
# Example: ["https://roparun.example.com"]
# Default (["*"]) is fine while testing but tighten before going live.
ROPARUN_CORS_ORIGINS=["https://roparun.example.com"]

# Optional. Without this the map still renders via MapLibre demotiles.
VITE_MAPTILER_KEY=
